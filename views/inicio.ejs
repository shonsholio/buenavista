<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Direkto — Ficha Técnica del Inmueble</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,340;0,9..144,440;0,9..144,560;1,9..144,440&family=Manrope:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  /* ============ TOKENS ============ */
  :root{
    --negro:#121110;
    --gris-oscuro:#2C2A26;
    --gris:#79766F;
    --gris-claro:#EDE9E1;
    --blanco:#FAF7F2;
    --mostaza:#C89A3C;
    --mostaza-oscuro:#8C6B22;
    --mostaza-suave:rgba(200,154,60,0.14);
    --serif:'Fraunces', serif;
    --sans:'Manrope', sans-serif;
    --mono:'Space Mono', monospace;
    --dur:0.7s;
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--blanco);
    color:var(--gris-oscuro);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  ::selection{background:var(--mostaza);color:var(--negro);}
  a{color:inherit;text-decoration:none;}
  img,svg{display:block;max-width:100%;}

  .wrap{max-width:1180px;margin:0 auto;padding:0 6vw;}

  /* ============ SCROLLBAR / PROGRESS ============ */
  #progress{
    position:fixed;top:0;left:0;height:2px;background:var(--mostaza);
    width:0%;z-index:400;transition:width 0.08s linear;
  }

  /* ============ RULER (signature element) ============ */
  #ruler{
    position:fixed;left:0;top:0;height:100vh;width:56px;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    z-index:300;pointer-events:none;
  }
  #ruler .track{
    position:relative;height:64vh;width:1px;background:rgba(44,42,38,0.16);
  }
  #ruler .tick{
    position:absolute;left:-9px;width:19px;height:1px;background:var(--gris);
    opacity:0.5;transition:background var(--dur),opacity var(--dur),transform var(--dur);
  }
  #ruler .tick.active{background:var(--mostaza);opacity:1;width:26px;left:-12.5px;transform:scaleX(1.05);}
  #ruler .tick .lbl{
    position:absolute;left:-108px;top:-6px;width:96px;text-align:right;
    font-family:var(--mono);font-size:9px;letter-spacing:0.12em;color:var(--gris);
    opacity:0;transition:opacity var(--dur);text-transform:uppercase;
  }
  #ruler .tick.active .lbl{opacity:1;color:var(--mostaza-oscuro);}
  #ruler .cap{
    font-family:var(--mono);font-size:9px;letter-spacing:0.15em;color:var(--gris);
    writing-mode:vertical-rl;text-orientation:mixed;margin-top:18px;opacity:0.55;
  }
  @media(max-width:900px){#ruler{display:none;}}

  /* ============ NAV ============ */
  header{
    position:fixed;top:0;left:0;right:0;z-index:200;
    display:flex;align-items:center;justify-content:space-between;
    padding:22px 6vw;mix-blend-mode:difference;
  }
  .logo{
    font-family:var(--mono);font-weight:700;letter-spacing:0.14em;
    font-size:14px;color:var(--blanco);
  }
  .logo span{color:var(--mostaza);}
  nav.cta{
    font-family:var(--mono);font-size:11px;letter-spacing:0.1em;
    text-transform:uppercase;color:var(--blanco);
    border:1px solid rgba(250,247,242,0.5);padding:9px 18px;
    transition:border-color .3s;
  }
  nav.cta:hover{border-color:var(--mostaza);}

  /* ============ HERO ============ */
  .hero{
    position:relative;min-height:100vh;background:var(--negro);color:var(--blanco);
    display:flex;align-items:center;overflow:hidden;
  }
  .hero .grid-bg{
    position:absolute;inset:0;opacity:0.5;
  }
  .hero-inner{
    position:relative;z-index:2;width:100%;
    display:grid;grid-template-columns:1.15fr 0.85fr;gap:40px;align-items:end;
    padding:140px 6vw 90px;
  }
  .eyebrow{
    font-family:var(--mono);font-size:11px;letter-spacing:0.18em;
    color:var(--mostaza);text-transform:uppercase;margin-bottom:22px;
    display:flex;align-items:center;gap:10px;
  }
  .eyebrow::before{content:'';width:22px;height:1px;background:var(--mostaza);}
  .hero h1{
    font-family:var(--serif);font-weight:440;font-size:clamp(38px,6vw,74px);
    line-height:1.02;letter-spacing:-0.01em;
  }
  .hero h1 em{font-style:italic;font-weight:340;color:var(--mostaza);}
  .hero .loc{
    margin-top:20px;font-family:var(--mono);font-size:13px;letter-spacing:0.04em;
    color:rgba(250,247,242,0.72);
  }
  .price-badge{
    justify-self:end;text-align:right;
  }
  .price-badge .tag{
    font-family:var(--mono);font-size:10px;letter-spacing:0.18em;color:var(--gris);
    text-transform:uppercase;margin-bottom:10px;
  }
  .price-badge .num{
    font-family:var(--serif);font-size:clamp(28px,3.4vw,42px);color:var(--blanco);
    border-top:1px solid var(--mostaza);padding-top:14px;font-weight:440;
  }
  .price-badge .sub{
    margin-top:6px;font-family:var(--mono);font-size:10.5px;color:var(--gris);
  }

  .floorplan{
    position:absolute;right:5vw;top:50%;transform:translateY(-58%);
    width:min(38vw,420px);opacity:0.9;z-index:1;pointer-events:none;
  }
  @media(max-width:900px){.floorplan{display:none;}}

  .scroll-cue{
    position:absolute;bottom:34px;left:6vw;z-index:2;
    font-family:var(--mono);font-size:10px;letter-spacing:0.14em;
    color:rgba(250,247,242,0.55);display:flex;align-items:center;gap:10px;
    text-transform:uppercase;
  }
  .scroll-cue .ln{width:1px;height:30px;background:linear-gradient(var(--mostaza),transparent);}

  @media(max-width:820px){
    .hero-inner{grid-template-columns:1fr;padding:130px 6vw 60px;gap:36px;}
    .price-badge{justify-self:start;text-align:left;}
  }

  /* ============ QUICK SPECS BAR ============ */
  .specbar{
    background:var(--gris-claro);border-bottom:1px solid rgba(44,42,38,0.1);
  }
  .specbar .row{
    display:grid;grid-template-columns:repeat(5,1fr);
  }
  .specbar .cell{
    padding:26px 18px;text-align:center;border-left:1px solid rgba(44,42,38,0.1);
  }
  .specbar .cell:first-child{border-left:none;}
  .specbar .cell .v{
    font-family:var(--mono);font-weight:700;font-size:clamp(18px,2.4vw,26px);color:var(--negro);
  }
  .specbar .cell .k{
    margin-top:6px;font-family:var(--mono);font-size:9.5px;letter-spacing:0.12em;
    color:var(--gris);text-transform:uppercase;
  }
  @media(max-width:700px){
    .specbar .row{grid-template-columns:repeat(2,1fr);}
    .specbar .cell:nth-child(3){border-left:none;}
  }

  /* ============ GALERÍA ============ */
  .gallery-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    grid-auto-rows:220px;
    gap:2px;
    background:rgba(44,42,38,0.14);
    border:1px solid rgba(44,42,38,0.14);
  }
  .g-item{
    position:relative;overflow:hidden;background:var(--gris-claro);
    cursor:pointer;
  }
  .g-item img{
    width:100%;height:100%;object-fit:cover;
    filter:saturate(0.92);
    transition:transform 1s cubic-bezier(.16,1,.3,1), filter .6s;
  }
  .g-item:hover img{transform:scale(1.045);filter:saturate(1.05);}
  .g-item .frame{
    position:absolute;top:12px;left:12px;
    font-family:var(--mono);font-size:10px;letter-spacing:0.08em;
    color:var(--mostaza);background:rgba(18,17,16,0.55);
    padding:4px 8px;
  }
  .g-item .cap{
    position:absolute;left:0;right:0;bottom:0;padding:14px 16px 12px;
    background:linear-gradient(to top, rgba(18,17,16,0.82), transparent);
    color:var(--blanco);font-family:var(--mono);font-size:10.5px;
    letter-spacing:0.08em;text-transform:uppercase;
    display:flex;justify-content:space-between;align-items:flex-end;
    opacity:0;transform:translateY(6px);transition:all .4s;
  }
  .g-item:hover .cap{opacity:1;transform:translateY(0);}
  .g-item .cap .zoom{color:var(--mostaza);font-size:9.5px;opacity:0.85;}
  .g-1{grid-column:1 / 3;grid-row:1 / 3;}
  .g-2{grid-column:3 / 4;grid-row:1 / 2;}
  .g-3{grid-column:4 / 5;grid-row:1 / 2;}
  .g-4{grid-column:3 / 4;grid-row:2 / 3;}
  .g-5{grid-column:4 / 5;grid-row:2 / 3;}
  .g-6{grid-column:1 / 3;grid-row:3 / 4;}
  .g-7{grid-column:3 / 5;grid-row:3 / 4;}
  .gallery-note{
    margin-top:20px;font-family:var(--mono);font-size:10.5px;color:var(--gris);
    letter-spacing:0.04em;display:flex;align-items:center;gap:8px;
  }
  .gallery-note::before{content:'';width:14px;height:1px;background:var(--mostaza);}
  @media(max-width:820px){
    .gallery-grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:180px;}
    .g-1{grid-column:1/3;grid-row:1/2;}
    .g-2{grid-column:1/2;grid-row:2/3;}
    .g-3{grid-column:2/3;grid-row:2/3;}
    .g-4{grid-column:1/2;grid-row:3/4;}
    .g-5{grid-column:2/3;grid-row:3/4;}
    .g-6{grid-column:1/2;grid-row:4/5;}
    .g-7{grid-column:2/3;grid-row:4/5;}
  }

  /* ============ LIGHTBOX ============ */
  .lightbox{
    position:fixed;inset:0;background:rgba(18,17,16,0.97);
    z-index:500;display:flex;align-items:center;justify-content:center;
    opacity:0;pointer-events:none;transition:opacity .35s ease;
  }
  .lightbox.open{opacity:1;pointer-events:auto;}
  .lightbox img{
    max-width:82vw;max-height:76vh;object-fit:contain;
    box-shadow:0 30px 80px rgba(0,0,0,0.5);
    transform:scale(0.97);transition:transform .35s ease;
  }
  .lightbox.open img{transform:scale(1);}
  .lb-cap{
    position:absolute;bottom:36px;left:50%;transform:translateX(-50%);
    font-family:var(--mono);font-size:11px;letter-spacing:0.1em;
    color:var(--mostaza);text-transform:uppercase;
  }
  .lb-close{
    position:absolute;top:28px;right:32px;background:none;border:1px solid rgba(250,247,242,0.3);
    color:var(--blanco);width:38px;height:38px;font-size:14px;cursor:pointer;
    transition:border-color .3s,color .3s;
  }
  .lb-close:hover{border-color:var(--mostaza);color:var(--mostaza);}
  .lb-nav{
    position:absolute;top:50%;transform:translateY(-50%);
    background:none;border:1px solid rgba(250,247,242,0.3);color:var(--blanco);
    width:44px;height:44px;font-size:16px;cursor:pointer;
    transition:border-color .3s,color .3s;
  }
  .lb-nav:hover{border-color:var(--mostaza);color:var(--mostaza);}
  .lb-prev{left:28px;}
  .lb-next{right:28px;}
  @media(max-width:700px){
    .lb-nav{width:36px;height:36px;font-size:13px;}
    .lb-prev{left:12px;}.lb-next{right:12px;}
    .lb-close{top:16px;right:16px;}
  }

  /* ============ SECTION SCAFFOLD ============ */
  section.doc{
    padding:110px 0;position:relative;
  }
  .sec-head{
    display:flex;align-items:baseline;gap:22px;margin-bottom:56px;
  }
  .sec-head .idx{
    font-family:var(--mono);font-size:13px;color:var(--mostaza);letter-spacing:0.08em;
  }
  .sec-head h2{
    font-family:var(--serif);font-weight:440;font-size:clamp(26px,3vw,38px);
    letter-spacing:-0.01em;
  }
  .sec-head .rule{flex:1;height:1px;background:rgba(44,42,38,0.14);}

  .reveal{opacity:0;transform:translateY(26px);transition:opacity 0.9s ease,transform 0.9s ease;}
  .reveal.in{opacity:1;transform:translateY(0);}

  /* ============ DESCRIPCIÓN ============ */
  .desc-grid{display:grid;grid-template-columns:0.9fr 1.1fr;gap:64px;}
  .desc-grid blockquote{
    font-family:var(--serif);font-style:italic;font-weight:340;
    font-size:clamp(21px,2.1vw,28px);line-height:1.4;color:var(--negro);
    border-left:2px solid var(--mostaza);padding-left:26px;
  }
  .desc-grid p{
    font-size:15.5px;line-height:1.85;color:var(--gris-oscuro);margin-bottom:18px;
  }
  .desc-grid p:last-child{margin-bottom:0;}
  @media(max-width:820px){.desc-grid{grid-template-columns:1fr;gap:34px;}}

  /* ============ DOSSIER (specs table) ============ */
  .dossier{
    display:grid;grid-template-columns:1fr 1fr;gap:0 70px;
  }
  .dossier-group{margin-bottom:46px;}
  .dossier-group h3{
    font-family:var(--mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;
    color:var(--mostaza-oscuro);margin-bottom:16px;padding-bottom:10px;
    border-bottom:1px solid rgba(200,154,60,0.35);
  }
  .spec-row{
    display:flex;align-items:baseline;gap:10px;padding:11px 0;
    border-bottom:1px dotted rgba(44,42,38,0.22);
    font-size:14px;
  }
  .spec-row .label{color:var(--gris);white-space:nowrap;}
  .spec-row .leader{flex:1;border-bottom:1px dotted rgba(44,42,38,0.0);}
  .spec-row .value{
    font-family:var(--mono);font-weight:700;color:var(--negro);text-align:right;white-space:nowrap;
  }
  @media(max-width:820px){.dossier{grid-template-columns:1fr;}}

  /* ============ AMENIDADES ============ */
  .amenities{
    display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
    background:rgba(44,42,38,0.14);border:1px solid rgba(44,42,38,0.14);
  }
  .amenity{
    background:var(--blanco);padding:34px 22px;transition:background var(--dur);
  }
  .amenity:hover{background:var(--mostaza-suave);}
  .amenity svg{width:26px;height:26px;stroke:var(--mostaza-oscuro);margin-bottom:16px;}
  .amenity .t{font-family:var(--sans);font-weight:600;font-size:14px;color:var(--negro);}
  @media(max-width:820px){.amenities{grid-template-columns:repeat(2,1fr);}}

  /* ============ UBICACIÓN ============ */
  .location{
    background:var(--negro);color:var(--blanco);
  }
  .loc-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
  .loc-grid .coords{
    font-family:var(--mono);font-size:11px;color:var(--gris);letter-spacing:0.08em;margin-bottom:22px;
  }
  .loc-grid h3{font-family:var(--serif);font-size:clamp(22px,2.6vw,30px);font-weight:440;margin-bottom:24px;}
  .nearby{list-style:none;}
  .nearby li{
    display:flex;justify-content:space-between;padding:13px 0;
    border-bottom:1px solid rgba(250,247,242,0.12);font-size:14px;
  }
  .nearby li span:last-child{font-family:var(--mono);color:var(--mostaza);font-size:12.5px;}
  .mapviz{border:1px solid rgba(250,247,242,0.16);aspect-ratio:1/1;position:relative;overflow:hidden;}
  .mapviz svg{width:100%;height:100%;}
  @media(max-width:820px){.loc-grid{grid-template-columns:1fr;gap:36px;}}

  /* ============ CONTACTO ============ */
  .contact{padding:120px 0 60px;}
  .contact-card{
    background:var(--gris-claro);border:1px solid rgba(44,42,38,0.1);
    padding:56px 6vw;display:grid;grid-template-columns:1.1fr 0.9fr;gap:50px;align-items:center;
  }
  .contact-card h2{
    font-family:var(--serif);font-weight:440;font-size:clamp(26px,3.2vw,38px);
    line-height:1.15;margin-bottom:18px;
  }
  .contact-card p{color:var(--gris);font-size:14.5px;line-height:1.7;max-width:42ch;}
  .agent{
    font-family:var(--mono);font-size:12px;color:var(--gris);margin-top:26px;line-height:1.9;
  }
  .agent strong{display:block;font-family:var(--sans);font-size:15px;color:var(--negro);font-weight:700;margin-bottom:4px;}
  .btns{display:flex;flex-direction:column;gap:12px;}
  .btn{
    font-family:var(--mono);font-size:12px;letter-spacing:0.08em;text-transform:uppercase;
    padding:17px 24px;text-align:center;transition:all .3s;border:1px solid var(--negro);
  }
  .btn.primary{background:var(--negro);color:var(--blanco);}
  .btn.primary:hover{background:var(--mostaza);border-color:var(--mostaza);color:var(--negro);}
  .btn.ghost{background:transparent;color:var(--negro);}
  .btn.ghost:hover{background:var(--negro);color:var(--blanco);}
  @media(max-width:820px){.contact-card{grid-template-columns:1fr;padding:40px 6vw;}}

  footer{
    padding:34px 6vw;display:flex;justify-content:space-between;align-items:center;
    font-family:var(--mono);font-size:10.5px;color:var(--gris);letter-spacing:0.06em;
  }
  footer .logo{color:var(--gris-oscuro);}
  footer .logo span{color:var(--mostaza-oscuro);}

  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    .reveal{opacity:1;transform:none;transition:none;}
  }
</style>
</head>
<body>

<div id="progress"></div>

<div id="ruler">
  <span class="cap">DK · REF-0142</span>
  <div class="track" id="rulerTrack"></div>
  <span class="cap">ESCALA 1:100</span>
</div>

<header>
  <div class="logo">dire<span>k</span>to</div>
  <a href="#contacto" class="cta">Agendar visita</a>
</header>

<!-- ============ HERO ============ -->
<section class="hero" id="s0" data-label="Portada">
  <svg class="grid-bg" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="bp" width="6" height="6" patternUnits="userSpaceOnUse">
        <path d="M6 0 L0 0 0 6" fill="none" stroke="#C89A3C" stroke-width="0.05" opacity="0.35"/>
      </pattern>
      <linearGradient id="fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#121110" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#121110" stop-opacity="0.95"/>
      </linearGradient>
    </defs>
    <rect width="100" height="100" fill="url(#bp)"/>
    <rect width="100" height="100" fill="url(#fade)"/>
  </svg>

  <svg class="floorplan" viewBox="0 0 320 380" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="20" y="20" width="280" height="340" stroke="#C89A3C" stroke-width="1" opacity="0.8"/>
    <line x1="20" y1="140" x2="300" y2="140" stroke="#C89A3C" stroke-width="0.6" opacity="0.55"/>
    <line x1="170" y1="20" x2="170" y2="140" stroke="#C89A3C" stroke-width="0.6" opacity="0.55"/>
    <line x1="20" y1="240" x2="180" y2="240" stroke="#C89A3C" stroke-width="0.6" opacity="0.55"/>
    <line x1="180" y1="140" x2="180" y2="360" stroke="#C89A3C" stroke-width="0.6" opacity="0.55"/>
    <line x1="90" y1="240" x2="90" y2="360" stroke="#C89A3C" stroke-width="0.6" opacity="0.4"/>
    <circle cx="250" cy="90" r="26" stroke="#C89A3C" stroke-width="0.5" opacity="0.4"/>
    <text x="30" y="36" fill="#C89A3C" font-family="Space Mono" font-size="7" opacity="0.7">SALA / COMEDOR</text>
    <text x="30" y="156" fill="#C89A3C" font-family="Space Mono" font-size="7" opacity="0.7">COCINA</text>
    <text x="190" y="36" fill="#C89A3C" font-family="Space Mono" font-size="7" opacity="0.7">ALCOBA PRINCIPAL</text>
    <text x="30" y="256" fill="#C89A3C" font-family="Space Mono" font-size="7" opacity="0.7">ALCOBA 2</text>
    <text x="100" y="256" fill="#C89A3C" font-family="Space Mono" font-size="7" opacity="0.7">ALCOBA 3</text>
    <text x="190" y="156" fill="#C89A3C" font-family="Space Mono" font-size="7" opacity="0.7">BALCÓN</text>
  </svg>

  <div class="hero-inner">
    <div>
      <div class="eyebrow">Ficha técnica · Ref. DK-0142</div>
      <h1>Apartamento<br><em>Altos del Parque</em></h1>
      <div class="loc">Cra. 53 #96-62 · Barranquilla, Atlántico</div>
    </div>
    <div class="price-badge">
      <div class="tag">Valor de venta</div>
      <div class="num">$487.000.000</div>
      <div class="sub">COP · negociable</div>
    </div>
  </div>

  <div class="scroll-cue"><div class="ln"></div>Desplázate</div>
</section>

<!-- ============ QUICK SPECS ============ -->
<div class="specbar">
  <div class="wrap">
