<script>
  // Scroll progress
  const progress = document.getElementById('progress');
  window.addEventListener('scroll', ()=>{
    const h = document.documentElement;
    const pct = (h.scrollTop)/(h.scrollHeight - h.clientHeight) * 100;
    progress.style.width = pct + '%';
  });

  // Ruler ticks generated from sections
  const sections = document.querySelectorAll('section[data-label]');
  const track = document.getElementById('rulerTrack');
  const ticks = [];
  sections.forEach((sec,i)=>{
    const tick = document.createElement('div');
    tick.className = 'tick';
    tick.style.top = (i/(sections.length-1))*100 + '%';
    const lbl = document.createElement('span');
    lbl.className = 'lbl';
    lbl.textContent = String(i).padStart(2,'0') + ' · ' + sec.dataset.label;
    tick.appendChild(lbl);
    track.appendChild(tick);
    ticks.push({el:tick, sec});
  });

  const io = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      const match = ticks.find(t=>t.sec===entry.target);
      if(entry.isIntersecting){
        ticks.forEach(t=>t.el.classList.remove('active'));
        if(match) match.el.classList.add('active');
      }
    });
  },{threshold:0.5});
  sections.forEach(s=>io.observe(s));

  // Galería interactiva / lightbox
  const items = Array.from(document.querySelectorAll('.g-item'));
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lbImg');
  const lbCap = document.getElementById('lbCap');
  let current = 0;

  function openLB(i){
    current = i;
    const img = items[i].querySelector('img');
    const label = items[i].querySelector('.cap span').textContent;
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    lbCap.textContent = 'IMG.' + String(i+1).padStart(2,'0') + ' — ' + label;
    lightbox.classList.add('open');
  }
  function closeLB(){ lightbox.classList.remove('open'); }
  function step(dir){ openLB((current + dir + items.length) % items.length); }

  items.forEach((item,i)=> item.addEventListener('click', ()=>openLB(i)) );
  document.getElementById('lbClose').addEventListener('click', closeLB);
  document.getElementById('lbPrev').addEventListener('click', ()=>step(-1));
  document.getElementById('lbNext').addEventListener('click', ()=>step(1));
  lightbox.addEventListener('click', (e)=>{ if(e.target === lightbox) closeLB(); });
  document.addEventListener('keydown', (e)=>{
    if(!lightbox.classList.contains('open')) return;
    if(e.key === 'Escape') closeLB();
    if(e.key === 'ArrowRight') step(1);
    if(e.key === 'ArrowLeft') step(-1);
  });

  // Reveal on scroll
  const revealIO = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('in'); });
  },{threshold:0.15});
  document.querySelectorAll('.reveal').forEach(el=>revealIO.observe(el));
</script>

